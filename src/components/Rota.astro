---
import Simge from './Simge.astro';
import type { SimgeAdi } from '~/data/simgeler';

interface Adim {
  simge: SimgeAdi;
  baslik: string;
  aciklama: string;
}

const adimlar: Adim[] = [
  {
    simge: 'dosyaAktar',
    baslik: 'Dosyaları Bırakın',
    aciklama:
      'Operatörden gelen BTK biçimli Excel dökümünü (.xlsx, .xls, .xlsb) sürükleyip bırakın. Sütun düzeni standart dışı olsa bile dosya bir uyarıyla içeri alınır.',
  },
  {
    simge: 'veriKatmani',
    baslik: 'Yerel Model Kurulur',
    aciklama:
      'Program, kayıtları kendi bilgisayarınızda işler ve sorgulanabilir hale getirir — milyar satır ölçeğine kadar, kurum sunucusuna gerek kalmadan.',
  },
  {
    simge: 'konumIsareti',
    baslik: 'Canlı Keşif',
    aciklama:
      'Sonuçları haritada kümeleyip zaman eksenine göre süzün, ya da düzenlenebilir bir ilişki diyagramında hatlar arasındaki bağlantıyı görün.',
  },
  {
    simge: 'onayRozeti',
    baslik: 'Kanıtlanabilir Çıktı',
    aciklama:
      'Bulguları Excel veya CSV olarak dışa aktarın; isterseniz yerel bir MSSQL/PostgreSQL veritabanına aktarıp kendi SQL sorgunuzla ilerleyin.',
  },
];
---

<ol class="zaman-cizelgesi">
  {
    adimlar.map((adim, i) => (
      <li class="zaman-adimi">
        <div class="zaman-isareti" aria-hidden="true" />
        <div class="zaman-icerik">
          <p class="belge-referansi zaman-adim-no">{`Adım ${String(i + 1).padStart(2, '0')}`}</p>
          <div class="mt-2 flex items-start gap-3">
            <span class="zaman-simge">
              <Simge ad={adim.simge} />
            </span>
            <div>
              <h3 class="text-lg font-semibold">{adim.baslik}</h3>
              <p class="mt-1.5 text-sm text-[color:var(--color-metin-ikincil)]">{adim.aciklama}</p>
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .zaman-cizelgesi {
    position: relative;
    max-width: 42rem;
    margin: 0;
    padding-left: 1.75rem;
    list-style: none;
  }
  .zaman-cizelgesi::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.3rem;
    width: 1px;
    background: var(--color-panel-cizgi-parlak);
  }
  .zaman-adimi {
    position: relative;
    padding-bottom: 2.5rem;
  }
  .zaman-adimi:last-child {
    padding-bottom: 0;
  }
  .zaman-isareti {
    position: absolute;
    top: 0.35rem;
    left: -1.75rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-zemin);
    border: 2px solid var(--color-tugla);
    transform: translateX(0.05rem);
  }
  .zaman-adim-no {
    margin-bottom: 0;
  }
  .zaman-simge {
    display: inline-flex;
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    color: var(--color-metin-ikincil);
    margin-top: 0.15rem;
  }
</style>
