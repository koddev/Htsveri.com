---
// Tüm sayfada sabit (fixed) kalan, hareketli düğüm/kenar ağı arka planı.
// tsParticles (slim paketi) ile yüklenir — elle yazılmış bir Canvas2D
// döngüsü yerine bakımı yapılan, üçüncü taraf bir kütüphane kullanılır.
---

<div class="veri-agi-kok" aria-hidden="true">
  <div class="izgara-zemin veri-agi-izgara"></div>
  <div class="veri-agi-parlama"></div>
  <div id="veri-agi-tuval"></div>
</div>

<style>
  .veri-agi-kok {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--color-zemin);
  }
  .veri-agi-izgara {
    position: absolute;
    inset: 0;
  }
  .veri-agi-parlama {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 40% at 20% 8%, color-mix(in srgb, var(--color-tugla) 10%, transparent), transparent 70%),
      radial-gradient(ellipse 45% 35% at 85% 70%, color-mix(in srgb, var(--color-panel-cizgi-parlak) 35%, transparent), transparent 70%);
  }
  #veri-agi-tuval {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { tsParticles, type Container } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const azaltilmisHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hedef = document.getElementById('veri-agi-tuval');

  // Azaltılmış hareket tercih edildiğinde animasyon hiç başlatılmaz; zemin,
  // ızgara ve parlama katmanları sabit kalır — bu, en sade ve en erişilebilir seçenektir.
  if (!azaltilmisHareket && hedef) {
    const mobilMi = window.matchMedia('(max-width: 640px)').matches;

    await loadSlim(tsParticles);

    const kapsayici: Container | undefined = await tsParticles.load({
      id: 'veri-agi-tuval',
      options: {
        fullScreen: { enable: false },
        fpsLimit: 30,
        detectRetina: true,
        pauseOnBlur: true,
        background: { color: { value: 'transparent' } },
        particles: {
          number: {
            value: mobilMi ? 22 : 60,
            density: { enable: true, width: 1920, height: 1080 },
          },
          color: {
            value: ['#9b968b', '#9b968b', '#9b968b', '#9b968b', '#9b968b', '#b23a2c'],
          },
          opacity: { value: 0.5 },
          size: { value: { min: 1, max: 2.4 } },
          links: {
            enable: true,
            distance: mobilMi ? 110 : 150,
            color: 'random',
            opacity: 0.2,
            width: 1,
          },
          move: {
            enable: true,
            speed: 0.3,
            direction: 'none',
            random: true,
            straight: false,
            outModes: { default: 'out' },
          },
        },
        interactivity: {
          events: { onHover: { enable: false }, onClick: { enable: false } },
        },
      },
    });

    // Kütüphanenin pauseOnBlur'u yalnızca pencere odağını kaybedince devreye
    // girer; sekme arka plana alındığında da (odak değişmeden) durdurmak için
    // visibilitychange olayını ayrıca dinliyoruz.
    document.addEventListener('visibilitychange', () => {
      if (!kapsayici) return;
      if (document.hidden) {
        kapsayici.pause();
      } else {
        kapsayici.play();
      }
    });
  }
</script>
