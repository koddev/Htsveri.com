---
import { simgeler, type SimgeAdi } from '~/data/simgeler';

interface Props {
  ad: SimgeAdi;
  etiket?: string;
  class?: string;
}

const { ad, etiket, class: sinif } = Astro.props;
const govde = simgeler[ad];
---

<svg
  viewBox="0 0 24 24"
  class={`simge ${sinif ?? ''}`}
  style="fill:currentColor"
  role={etiket ? 'img' : undefined}
  aria-label={etiket}
  aria-hidden={etiket ? undefined : 'true'}
  set:html={govde}
/>

<style>
  .simge {
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    flex-shrink: 0;
  }
</style>
