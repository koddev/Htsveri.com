---
import { ayar } from '~/ayar';

const yil = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-panel-cizgi)] py-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-3">
      <span class="text-sm font-semibold">{ayar.marka}</span>
      <nav class="flex flex-wrap items-center gap-5 text-sm text-[color:var(--color-metin-ikincil)]">
        {ayar.nav.map((oge) => <a href={oge.href} class="transition-colors hover:text-[color:var(--color-metin)]">{oge.etiket}</a>)}
      </nav>
      {
        ayar.iletisim.eposta && (
          <a href={`mailto:${ayar.iletisim.eposta}`} class="text-sm text-[color:var(--color-metin-ikincil)] hover:text-[color:var(--color-metin)]">
            {ayar.iletisim.eposta}
          </a>
        )
      }
    </div>
    <p class="belge-referansi">{`© ${yil} HTS Analiz Programı`}</p>
  </div>
</footer>
