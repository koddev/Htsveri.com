---
import { ayar } from '~/ayar';

const yil = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-panel-cizgi)] py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 text-center">
    <span class="font-display text-base font-bold">{ayar.marka}</span>
    <nav class="flex flex-wrap items-center justify-center gap-5 text-sm text-[color:var(--color-metin-ikincil)]">
      {ayar.nav.map((oge) => <a href={oge.href} class="transition-colors hover:text-[color:var(--color-siyan)]">{oge.etiket}</a>)}
    </nav>
    {
      ayar.iletisim.eposta && (
        <a href={`mailto:${ayar.iletisim.eposta}`} class="text-sm text-[color:var(--color-metin-ikincil)] hover:text-[color:var(--color-siyan)]">
          {ayar.iletisim.eposta}
        </a>
      )
    }
    <p class="text-xs text-[color:var(--color-metin-soluk)]">© {yil} {ayar.marka}. Tüm hakları saklıdır.</p>
  </div>
</footer>
