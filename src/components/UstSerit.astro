---
import { ayar } from '~/ayar';
import IndirmeButonu from './IndirmeButonu.astro';
---

<header class="ust-serit">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 text-base font-semibold">
      <span class="ust-serit-sembol" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20">
          <rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="#b23a2c" stroke-width="1.6" />
          <path d="M8 12h8M12 8v8" stroke="#b23a2c" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </span>
      <span>{ayar.marka}</span>
    </a>

    <nav class="ust-serit-nav hidden items-center gap-6 text-sm text-[color:var(--color-metin-ikincil)] md:flex">
      {ayar.nav.map((oge) => <a href={oge.href} class="transition-colors hover:text-[color:var(--color-metin)]">{oge.etiket}</a>)}
    </nav>

    <IndirmeButonu etiket="Ücretsiz İndir" varyant="ikincil" class="ust-serit-buton hidden sm:inline-flex" />
  </div>
</header>

<style>
  .ust-serit {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-panel-cizgi);
    background: color-mix(in srgb, var(--color-zemin) 85%, transparent);
    backdrop-filter: blur(10px);
  }
  .ust-serit-buton {
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
  }
</style>
