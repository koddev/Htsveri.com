---
import { ayar } from '~/ayar';
import IndirmeButonu from './IndirmeButonu.astro';
---

<header class="ust-serit">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold">
      <span class="ust-serit-sembol" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28">
          <defs>
            <linearGradient id="ust-serit-gradyan" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#22b88c" />
              <stop offset="100%" stop-color="#3e5c76" />
            </linearGradient>
          </defs>
          <circle cx="16" cy="15" r="13" fill="#141715" />
          <g stroke="url(#ust-serit-gradyan)" stroke-width="1.4" opacity="0.85">
            <line x1="16" y1="15" x2="7" y2="10"></line>
            <line x1="16" y1="15" x2="25" y2="10"></line>
            <line x1="16" y1="15" x2="9" y2="23"></line>
            <line x1="16" y1="15" x2="23" y2="23"></line>
          </g>
          <circle cx="16" cy="15" r="3.4" fill="url(#ust-serit-gradyan)"></circle>
          <circle cx="7" cy="10" r="1.7" fill="#22b88c"></circle>
          <circle cx="25" cy="10" r="1.7" fill="#22b88c"></circle>
          <circle cx="9" cy="23" r="1.7" fill="#3e5c76"></circle>
          <circle cx="23" cy="23" r="1.7" fill="#3e5c76"></circle>
        </svg>
      </span>
      <span>{ayar.marka}</span>
    </a>

    <nav class="ust-serit-nav hidden items-center gap-6 text-sm font-medium text-[color:var(--color-metin-ikincil)] md:flex">
      {ayar.nav.map((oge) => <a href={oge.href} class="transition-colors hover:text-[color:var(--color-siyan)]">{oge.etiket}</a>)}
    </nav>

    <IndirmeButonu etiket="Ücretsiz İndir" class="ust-serit-buton hidden sm:inline-flex" />
  </div>
</header>

<style>
  .ust-serit {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-panel-cizgi);
    background: color-mix(in srgb, var(--color-zemin) 78%, transparent);
    backdrop-filter: blur(10px);
  }
  .ust-serit-buton {
    padding: 0.55rem 1.2rem;
    font-size: 0.9rem;
  }
</style>
