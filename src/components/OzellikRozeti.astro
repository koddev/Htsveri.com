---
import Simge from './Simge.astro';
import type { SimgeAdi } from '~/data/simgeler';

interface Props {
  simge: SimgeAdi;
  renk?: 'siyan' | 'mavi' | 'mor' | 'pembe' | 'yesil';
}

const { simge, renk = 'siyan' } = Astro.props;
---

<span class={`rozet rozet-${renk}`}>
  <Simge ad={simge} class="rozet-simge" />
</span>

<style>
  .rozet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-rozet);
    flex-shrink: 0;
  }
  .rozet-simge {
    width: 1.4rem;
    height: 1.4rem;
  }
  .rozet-siyan {
    color: var(--color-siyan);
    background: color-mix(in srgb, var(--color-siyan) 16%, transparent);
    box-shadow: 0 0 22px -6px color-mix(in srgb, var(--color-siyan) 70%, transparent);
  }
  .rozet-mavi {
    color: var(--color-mavi);
    background: color-mix(in srgb, var(--color-mavi) 16%, transparent);
    box-shadow: 0 0 22px -6px color-mix(in srgb, var(--color-mavi) 70%, transparent);
  }
  .rozet-mor {
    color: var(--color-mor);
    background: color-mix(in srgb, var(--color-mor) 16%, transparent);
    box-shadow: 0 0 22px -6px color-mix(in srgb, var(--color-mor) 70%, transparent);
  }
  .rozet-pembe {
    color: var(--color-pembe);
    background: color-mix(in srgb, var(--color-pembe) 16%, transparent);
    box-shadow: 0 0 22px -6px color-mix(in srgb, var(--color-pembe) 70%, transparent);
  }
  .rozet-yesil {
    color: var(--color-yesil);
    background: color-mix(in srgb, var(--color-yesil) 16%, transparent);
    box-shadow: 0 0 22px -6px color-mix(in srgb, var(--color-yesil) 70%, transparent);
  }
</style>
