---
import Simge from './Simge.astro';

const yerelKalanlar = [
  'Operatörden gelen ham Excel dosyaları',
  'Programın oluşturduğu yerel çalışma alanı ve dizinler',
  'Analiz sonuçları, harita katmanları ve ilişki diyagramları',
  'Excel/CSV çıktıları ve rapor taslakları',
];
---

<div class="mx-auto max-w-3xl">
  <div class="cam-panel veri-kapsulu-panel p-8 sm:p-10">
    <div class="veri-kapsulu-halka" aria-hidden="true">
      <Simge ad="korumaKalkani" class="veri-kapsulu-simge" />
    </div>
    <h3 class="text-center text-2xl font-bold sm:text-3xl">Kapalı Devre Çalışır</h3>
    <p class="mt-3 text-center text-[color:var(--color-metin-ikincil)]">
      Program, kurulduğu bilgisayarın dışına hiçbir soruşturma verisi çıkarmadan çalışacak şekilde tasarlandı.
    </p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        yerelKalanlar.map((madde) => (
          <li class="flex items-start gap-3 text-sm text-[color:var(--color-metin)]">
            <span class="veri-kapsulu-onay" aria-hidden="true">
              <Simge ad="onayRozeti" />
            </span>
            <span>{madde}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 border-t border-[color:var(--color-panel-cizgi)] pt-5 text-center text-sm text-[color:var(--color-metin-soluk)]">
      Merkezî sunucuya giden tek veri, hesabınıza giriş yapmak için gerekli e-posta adresi ve parola bilgisidir.
    </p>
  </div>
</div>

<style>
  .veri-kapsulu-panel {
    position: relative;
  }
  .veri-kapsulu-halka {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-siyan) 14%, transparent);
    box-shadow: 0 0 40px -6px color-mix(in srgb, var(--color-siyan) 60%, transparent);
    color: var(--color-siyan);
  }
  .veri-kapsulu-simge {
    width: 2.1rem;
    height: 2.1rem;
  }
  .veri-kapsulu-onay {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    color: var(--color-yesil);
  }
</style>
