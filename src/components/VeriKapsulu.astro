---
// Veri Güvenliği bölümü — iki sütunlu bir manifesto/defter tablosu:
// cihazda kalanlar (onaylı, yeşil işaretli) ve merkeze giden tek istisna.
import Simge from './Simge.astro';

const yerelKalanlar = [
  'Operatörden gelen ham Excel dosyaları',
  'Programın oluşturduğu yerel çalışma alanı ve dizinler',
  'Analiz sonuçları, harita katmanları ve ilişki diyagramları',
  'Excel/CSV çıktıları ve rapor taslakları',
];

const merkezeGiden = ['Hesap girişi için e-posta adresi ve parola bilgisi'];
---

<div class="veri-tablosu">
  <div class="veri-tablosu-sutun">
    <h3 class="veri-tablosu-baslik">Cihazınızda Kalır</h3>
    <ul>
      {
        yerelKalanlar.map((madde) => (
          <li class="cizgili-satir veri-tablosu-satir">
            <span class="veri-tablosu-onay" aria-hidden="true">
              <Simge ad="onayRozeti" />
            </span>
            <span>{madde}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="veri-tablosu-sutun">
    <h3 class="veri-tablosu-baslik">Merkeze Giden</h3>
    <ul>
      {
        merkezeGiden.map((madde) => (
          <li class="cizgili-satir veri-tablosu-satir veri-tablosu-satir-notr">
            <span>{madde}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-[color:var(--color-metin-soluk)]">
      Soruşturma dosyalarınız ya da analiz sonuçlarınız bu listeye hiçbir zaman eklenmez.
    </p>
  </div>
</div>

<style>
  .veri-tablosu {
    display: grid;
    gap: 2.5rem;
    max-width: 52rem;
  }
  @media (min-width: 768px) {
    .veri-tablosu {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .veri-tablosu-baslik {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-metin);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-panel-cizgi-parlak);
    margin-bottom: 0.25rem;
  }
  .veri-tablosu-satir {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem 0;
    font-size: var(--text-sm);
    color: var(--color-metin);
  }
  .veri-tablosu-satir-notr {
    color: var(--color-metin-ikincil);
  }
  .veri-tablosu-onay {
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-onay);
  }
</style>
