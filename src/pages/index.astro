---
import Kabuk from '~/layouts/Kabuk.astro';
import Blok from '~/components/Blok.astro';
import Panel from '~/components/Panel.astro';
import OzellikRozeti from '~/components/OzellikRozeti.astro';
import Rota from '~/components/Rota.astro';
import VeriKapsulu from '~/components/VeriKapsulu.astro';
import SoruCevap from '~/components/SoruCevap.astro';
import IndirmeButonu from '~/components/IndirmeButonu.astro';
import { ayar } from '~/ayar';
import { ozellikler } from '~/data/ozellikler';
import { istatistikler } from '~/data/istatistikler';
import { sorular } from '~/data/sorular';

const yazilimJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: ayar.marka,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Windows 10, Windows 11',
  description: ayar.ozet,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
  url: ayar.siteUrl,
};

const sssJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorular.map((s) => ({
    '@type': 'Question',
    name: s.soru,
    acceptedAnswer: {
      '@type': 'Answer',
      text: s.cevap,
    },
  })),
};
---

<Kabuk baslik="HTS Analiz Programı — HTS Kayıt Analizi">
  <Fragment slot="head-ekstra">
    <script type="application/ld+json" set:html={JSON.stringify(yazilimJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(sssJsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
    <div class="mx-auto max-w-4xl text-center">
      <span class="hap-etiket">HTS Kayıt Analizi</span>
      <h1 class="gradyan-baslik mt-6 text-4xl font-extrabold text-balance sm:text-5xl lg:text-6xl">
        Binlerce Satırlık HTS Dökümünü Dakikalar İçinde Anlamlı Bulguya Çevirin
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-[color:var(--color-metin-ikincil)]">
        Baz istasyonu, IMEI, CGNAT ve irtibat analizini hazır sorgularla çalıştırın; sonucu haritada ya da
        ilişki grafiğinde inceleyin — hepsi kendi bilgisayarınızda, hiçbir veri dışarı çıkmadan.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <IndirmeButonu etiket="Ücretsiz İndir" />
        <a href="#nasil-calisir" class="buton-ikincil">Nasıl Çalıştığını Gör</a>
      </div>
      <dl class="mx-auto mt-14 grid max-w-xl grid-cols-3 gap-4">
        {
          istatistikler.map((ist) => (
            <div class="cam-panel px-3 py-4 text-center">
              <dt class="sr-only">{ist.etiket}</dt>
              <dd class="font-display text-2xl font-extrabold text-[color:var(--color-siyan)] sm:text-3xl">{ist.deger}</dd>
              <dd class="mt-1 text-xs text-[color:var(--color-metin-ikincil)] sm:text-sm">{ist.etiket}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Özellikler -->
  <Blok
    id="ozellikler"
    hap="Yetenekler"
    baslik="Tek Programda Uçtan Uca HTS Analizi"
    aciklama="Her kart, gerçek bir analiz özelliğine karşılık gelir — pazarlama süsü değil."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        ozellikler.map((oz) => (
          <Panel as="article">
            <OzellikRozeti simge={oz.simge} renk={oz.renk} />
            <h3 class="mt-4 text-lg font-bold">{oz.baslik}</h3>
            <p class="mt-2 text-sm text-[color:var(--color-metin-ikincil)]">{oz.aciklama}</p>
          </Panel>
        ))
      }
    </div>
  </Blok>

  <!-- Nasıl Çalışır -->
  <Blok
    id="nasil-calisir"
    hap="Süreç"
    baslik="Dosyadan Bulguya, Dört Adımda"
    aciklama="Excel dökümünü bıraktığınız andan kanıtlanabilir çıktıya kadar tüm süreç kendi bilgisayarınızda ilerler."
  >
    <Rota />
  </Blok>

  <!-- Veri Güvenliği -->
  <Blok
    id="veri-guvenligi"
    hap="Veri Güvenliği"
    baslik="Soruşturma Verisi Bilgisayarınızdan Çıkmaz"
  >
    <VeriKapsulu />
  </Blok>

  <!-- SSS -->
  <Blok id="sss" hap="Sık Sorulanlar" baslik="Merak Edilenler">
    <SoruCevap />
  </Blok>

  <!-- İndirme CTA -->
  <section id="indir" class="px-6 py-24">
    <div class="cam-panel mx-auto max-w-3xl px-8 py-14 text-center">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Hemen İndirin, Ücretsiz Kullanmaya Başlayın</h2>
      <p class="mx-auto mt-4 max-w-xl text-[color:var(--color-metin-ikincil)]">
        Kurulum birkaç dakika sürer. Hesap oluşturma işlemi program içinden yapılır, kredi kartı bilgisi istenmez.
      </p>
      <div class="mt-8 flex justify-center">
        <IndirmeButonu etiket="Ücretsiz İndir" />
      </div>
    </div>
  </section>
</Kabuk>
