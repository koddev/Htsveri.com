---
import Kabuk from '~/layouts/Kabuk.astro';
import Blok from '~/components/Blok.astro';
import KayitSatiri from '~/components/KayitSatiri.astro';
import Rota from '~/components/Rota.astro';
import VeriKapsulu from '~/components/VeriKapsulu.astro';
import SoruCevap from '~/components/SoruCevap.astro';
import IndirmeButonu from '~/components/IndirmeButonu.astro';
import { ayar } from '~/ayar';
import { ozellikler } from '~/data/ozellikler';
import { istatistikler } from '~/data/istatistikler';
import { sorular } from '~/data/sorular';

const yazilimJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: ayar.marka,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Windows 10, Windows 11',
  description: ayar.ozet,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
  url: ayar.siteUrl,
};

const sssJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorular.map((s) => ({
    '@type': 'Question',
    name: s.soru,
    acceptedAnswer: {
      '@type': 'Answer',
      text: s.cevap,
    },
  })),
};
---

<Kabuk baslik="HTS Analiz Programı — HTS Kayıt Analizi">
  <Fragment slot="head-ekstra">
    <script type="application/ld+json" set:html={JSON.stringify(yazilimJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(sssJsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-16 pb-20 sm:pt-20 sm:pb-24">
    <div class="mx-auto max-w-2xl">
      <p class="belge-referansi">HTS-2024 / Analiz Konsolu</p>
      <h1 class="mt-5 text-4xl font-semibold text-balance sm:text-5xl">
        Binlerce Satırlık HTS Dökümünü Dakikalar İçinde Anlamlı Bulguya Çevirin
      </h1>
      <p class="mt-5 text-base text-[color:var(--color-metin-ikincil)] sm:text-lg">
        Baz istasyonu, IMEI, CGNAT ve irtibat analizini hazır sorgularla çalıştırın; sonucu haritada ya da
        ilişki grafiğinde inceleyin — hepsi kendi bilgisayarınızda, hiçbir veri dışarı çıkmadan.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <IndirmeButonu etiket="Ücretsiz İndir" />
        <a href="#nasil-calisir" class="buton-ikincil">Nasıl Çalıştığını Gör</a>
      </div>
      <dl class="mt-12 flex max-w-md divide-x divide-[color:var(--color-panel-cizgi)]">
        {
          istatistikler.map((ist) => (
            <div class="flex-1 px-5 first:pl-0">
              <dt class="text-xs text-[color:var(--color-metin-soluk)]">{ist.etiket}</dt>
              <dd class="mt-1 font-mono text-2xl font-medium text-[color:var(--color-tugla)] sm:text-3xl">{ist.deger}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Özellikler -->
  <Blok
    id="ozellikler"
    referans="İçindekiler / Yetenekler"
    baslik="Tek Programda Uçtan Uca HTS Analizi"
    aciklama="Her satır, gerçek bir analiz özelliğine karşılık gelir — pazarlama süsü değil."
  >
    <div>
      {ozellikler.map((oz, i) => <KayitSatiri index={i + 1} simge={oz.simge} baslik={oz.baslik} aciklama={oz.aciklama} />)}
    </div>
  </Blok>

  <!-- Nasıl Çalışır -->
  <Blok
    id="nasil-calisir"
    referans="Süreç"
    baslik="Dosyadan Bulguya, Dört Adımda"
    aciklama="Excel dökümünü bıraktığınız andan kanıtlanabilir çıktıya kadar tüm süreç kendi bilgisayarınızda ilerler."
  >
    <Rota />
  </Blok>

  <!-- Veri Güvenliği -->
  <Blok
    id="veri-guvenligi"
    referans="Veri Güvenliği"
    baslik="Soruşturma Verisi Bilgisayarınızdan Çıkmaz"
  >
    <VeriKapsulu />
  </Blok>

  <!-- SSS -->
  <Blok id="sss" referans="Sık Sorulanlar" baslik="Merak Edilenler">
    <SoruCevap />
  </Blok>

  <!-- İndirme CTA -->
  <section id="indir" class="px-6 py-20 sm:py-24">
    <div class="kayit-paneli mx-auto max-w-3xl px-8 py-12 sm:px-12 sm:py-14">
      <h2 class="text-2xl font-semibold sm:text-3xl">Hemen İndirin, Ücretsiz Kullanmaya Başlayın</h2>
      <p class="mt-3 max-w-xl text-[color:var(--color-metin-ikincil)]">
        Kurulum birkaç dakika sürer. Hesap oluşturma işlemi program içinden yapılır, kredi kartı bilgisi istenmez.
      </p>
      <div class="mt-7">
        <IndirmeButonu etiket="Ücretsiz İndir" />
      </div>
    </div>
  </section>
</Kabuk>
